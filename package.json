{
  "name": "arnavkulkarni-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:unavailable": "E2E_README_MODE=unavailable playwright test",
    "test:catan": "node --experimental-strip-types --test tests/catan/*.test.ts",
    "test:catan:browser": "playwright test --config playwright.catan.config.ts",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "catan:prepare-local": "node scripts/prepare-catan-local.mjs",
    "catan:local": "node scripts/start-catan-local.mjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@vercel/queue": "^0.7.0",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "undici": "8.11.0"
  }
}
