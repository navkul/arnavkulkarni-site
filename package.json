{
  "name": "arnavkulkarni-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:unavailable": "E2E_STRAVA_MODE=unavailable playwright test"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "undici": "8.10.2"
  }
}
